# Choose a version from https://github.com/rclsilver/threavia/releases (without v).
# Pin the same release for Core and new backends. 0.22.0 is an example release.
THREAVIA_VERSION=0.22.0
# Replace before first start. This file is loaded by Docker Compose, not your shell.
THREAVIA_POSTGRES_PASSWORD=replace-with-a-local-database-password
