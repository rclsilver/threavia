{
  "name": "threavia",
  "displayName": "Threavia",
  "description": "Follow and answer your Threavia coding agents from the editor.",
  "version": "0.0.0",
  "publisher": "rclsilver",
  "license": "Apache-2.0",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rclsilver/threavia.git",
    "directory": "clients/vscode"
  },
  "homepage": "https://github.com/rclsilver/threavia/tree/master/clients/vscode",
  "bugs": "https://github.com/rclsilver/threavia/issues",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agents",
    "claude",
    "threavia"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onAuthenticationRequest:threavia",
    "onWebviewPanel:threavia.conversation"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threavia",
          "title": "Threavia",
          "icon": "media/threavia.svg"
        }
      ]
    },
    "views": {
      "threavia": [
        {
          "id": "threavia.sidebar",
          "name": "Sessions",
          "icon": "media/threavia.svg",
          "contextualTitle": "Threavia"
        },
        {
          "id": "threavia.tasks",
          "name": "Tasks",
          "icon": "media/threavia.svg",
          "contextualTitle": "Threavia"
        },
        {
          "id": "threavia.memory",
          "name": "Memory",
          "icon": "media/threavia.svg",
          "contextualTitle": "Threavia"
        },
        {
          "id": "threavia.backends",
          "name": "Backends",
          "visibility": "collapsed",
          "contextualTitle": "Threavia"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threavia.sidebar",
        "contents": "Threavia shows your agents' sessions here, and what waits for you.\n[Add a Core](command:threavia.addCore)",
        "when": "threavia.state == unconfigured"
      },
      {
        "view": "threavia.sidebar",
        "contents": "Sign in to see your sessions.\n[Sign In](command:threavia.signIn)",
        "when": "threavia.state == signedOut"
      },
      {
        "view": "threavia.sidebar",
        "contents": "Core does not answer.\n[Try Again](command:threavia.refresh)\n[Set Core URL](command:threavia.setCoreUrl)",
        "when": "threavia.state == unreachable"
      },
      {
        "view": "threavia.tasks",
        "contents": "Threavia shows what a Project still owes here.\n[Add a Core](command:threavia.addCore)",
        "when": "threavia.state == unconfigured"
      },
      {
        "view": "threavia.tasks",
        "contents": "Sign in to see what a Project still owes.\n[Sign In](command:threavia.signIn)",
        "when": "threavia.state == signedOut"
      },
      {
        "view": "threavia.tasks",
        "contents": "Core does not answer.\n[Try Again](command:threavia.refresh)\n[Set Core URL](command:threavia.setCoreUrl)",
        "when": "threavia.state == unreachable"
      },
      {
        "view": "threavia.memory",
        "contents": "Threavia shows what a Project decided here.\n[Add a Core](command:threavia.addCore)",
        "when": "threavia.state == unconfigured"
      },
      {
        "view": "threavia.memory",
        "contents": "Sign in to see what a Project decided.\n[Sign In](command:threavia.signIn)",
        "when": "threavia.state == signedOut"
      },
      {
        "view": "threavia.memory",
        "contents": "Core does not answer.\n[Try Again](command:threavia.refresh)\n[Set Core URL](command:threavia.setCoreUrl)",
        "when": "threavia.state == unreachable"
      }
    ],
    "authentication": [
      {
        "id": "threavia",
        "label": "Threavia"
      }
    ],
    "commands": [
      {
        "command": "threavia.signIn",
        "title": "Sign In",
        "category": "Threavia"
      },
      {
        "command": "threavia.signOut",
        "title": "Sign Out",
        "category": "Threavia"
      },
      {
        "command": "threavia.setCoreUrl",
        "title": "Set Core URL…",
        "category": "Threavia"
      },
      {
        "command": "threavia.addCore",
        "title": "Add Core…",
        "category": "Threavia",
        "icon": "$(add)"
      },
      {
        "command": "threavia.renameCore",
        "title": "Rename Core…",
        "category": "Threavia"
      },
      {
        "command": "threavia.removeCore",
        "title": "Remove Core",
        "category": "Threavia"
      },
      {
        "command": "threavia.refresh",
        "title": "Refresh",
        "category": "Threavia",
        "icon": "$(refresh)"
      },
      {
        "command": "threavia.showWaiting",
        "title": "Show What Is Waiting",
        "category": "Threavia",
        "icon": "$(inbox)"
      },
      {
        "command": "threavia.openSession",
        "title": "Open Session",
        "category": "Threavia"
      },
      {
        "command": "threavia.ask",
        "title": "Ask Threavia About This…",
        "category": "Threavia",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threavia.newSession",
        "title": "New Session",
        "category": "Threavia",
        "icon": "$(add)"
      },
      {
        "command": "threavia.pinSession",
        "title": "Pin",
        "category": "Threavia",
        "icon": "$(pin)"
      },
      {
        "command": "threavia.unpinSession",
        "title": "Unpin",
        "category": "Threavia",
        "icon": "$(pinned)"
      },
      {
        "command": "threavia.renameSession",
        "title": "Rename…",
        "category": "Threavia"
      },
      {
        "command": "threavia.archiveSession",
        "title": "Archive",
        "category": "Threavia"
      },
      {
        "command": "threavia.openInBrowser",
        "title": "Open in Browser",
        "category": "Threavia",
        "icon": "$(link-external)"
      },
      {
        "command": "threavia.refreshRepository",
        "title": "Refresh from Origin",
        "category": "Threavia",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "threavia.approve",
        "title": "Approve",
        "category": "Threavia",
        "icon": "$(check)"
      },
      {
        "command": "threavia.deny",
        "title": "Deny",
        "category": "Threavia",
        "icon": "$(close)"
      },
      {
        "command": "threavia.answer",
        "title": "Answer…",
        "category": "Threavia",
        "icon": "$(reply)"
      },
      {
        "command": "threavia.switchProject",
        "title": "Switch Project…",
        "category": "Threavia",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "threavia.newTask",
        "title": "New Task",
        "category": "Threavia",
        "icon": "$(add)"
      },
      {
        "command": "threavia.openTask",
        "title": "Open Task",
        "category": "Threavia"
      },
      {
        "command": "threavia.startTask",
        "title": "Start",
        "category": "Threavia",
        "icon": "$(play)"
      },
      {
        "command": "threavia.completeTask",
        "title": "Mark Done",
        "category": "Threavia",
        "icon": "$(check)"
      },
      {
        "command": "threavia.reopenTask",
        "title": "Reopen",
        "category": "Threavia",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "threavia.setTaskTodo",
        "title": "To Do",
        "category": "Threavia"
      },
      {
        "command": "threavia.setTaskInProgress",
        "title": "In Progress",
        "category": "Threavia"
      },
      {
        "command": "threavia.setTaskDone",
        "title": "Done",
        "category": "Threavia"
      },
      {
        "command": "threavia.editTaskTitle",
        "title": "Edit Title…",
        "category": "Threavia"
      },
      {
        "command": "threavia.editTaskDetails",
        "title": "Edit Details…",
        "category": "Threavia"
      },
      {
        "command": "threavia.taskDependencies",
        "title": "Dependencies…",
        "category": "Threavia"
      },
      {
        "command": "threavia.deleteTask",
        "title": "Delete…",
        "category": "Threavia"
      },
      {
        "command": "threavia.recordDecision",
        "title": "Record Decision",
        "category": "Threavia",
        "icon": "$(add)"
      },
      {
        "command": "threavia.openDecision",
        "title": "Open Decision",
        "category": "Threavia"
      },
      {
        "command": "threavia.pinDecision",
        "title": "Pin",
        "category": "Threavia",
        "icon": "$(pin)"
      },
      {
        "command": "threavia.unpinDecision",
        "title": "Unpin",
        "category": "Threavia",
        "icon": "$(pinned)"
      },
      {
        "command": "threavia.supersedeDecision",
        "title": "Supersede…",
        "category": "Threavia"
      },
      {
        "command": "threavia.deleteDecision",
        "title": "Delete…",
        "category": "Threavia"
      }
    ],
    "submenus": [
      {
        "id": "threavia.taskStatus",
        "label": "Status"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "threavia.openSession",
          "when": "false"
        },
        {
          "command": "threavia.pinSession",
          "when": "activeWebviewPanelId == 'threavia.conversation' && !threavia.conversationPinned && !threavia.conversationDraft"
        },
        {
          "command": "threavia.unpinSession",
          "when": "activeWebviewPanelId == 'threavia.conversation' && threavia.conversationPinned && !threavia.conversationDraft"
        },
        {
          "command": "threavia.renameSession",
          "when": "false"
        },
        {
          "command": "threavia.archiveSession",
          "when": "false"
        },
        {
          "command": "threavia.openInBrowser",
          "when": "activeWebviewPanelId == 'threavia.conversation' && !threavia.conversationDraft"
        },
        {
          "command": "threavia.refreshRepository",
          "when": "false"
        },
        {
          "command": "threavia.approve",
          "when": "false"
        },
        {
          "command": "threavia.deny",
          "when": "false"
        },
        {
          "command": "threavia.answer",
          "when": "false"
        },
        {
          "command": "threavia.ask",
          "when": "editorIsOpen && threavia.state == ready"
        },
        {
          "command": "threavia.newSession",
          "when": "threavia.state == ready"
        },
        {
          "command": "threavia.openTask",
          "when": "false"
        },
        {
          "command": "threavia.startTask",
          "when": "false"
        },
        {
          "command": "threavia.completeTask",
          "when": "false"
        },
        {
          "command": "threavia.reopenTask",
          "when": "false"
        },
        {
          "command": "threavia.setTaskTodo",
          "when": "false"
        },
        {
          "command": "threavia.setTaskInProgress",
          "when": "false"
        },
        {
          "command": "threavia.setTaskDone",
          "when": "false"
        },
        {
          "command": "threavia.editTaskTitle",
          "when": "false"
        },
        {
          "command": "threavia.editTaskDetails",
          "when": "false"
        },
        {
          "command": "threavia.taskDependencies",
          "when": "false"
        },
        {
          "command": "threavia.deleteTask",
          "when": "false"
        },
        {
          "command": "threavia.openDecision",
          "when": "false"
        },
        {
          "command": "threavia.pinDecision",
          "when": "false"
        },
        {
          "command": "threavia.unpinDecision",
          "when": "false"
        },
        {
          "command": "threavia.supersedeDecision",
          "when": "false"
        },
        {
          "command": "threavia.deleteDecision",
          "when": "false"
        },
        {
          "command": "threavia.switchProject",
          "when": "threavia.state == ready"
        },
        {
          "command": "threavia.newTask",
          "when": "threavia.state == ready && threavia.hasProject"
        },
        {
          "command": "threavia.recordDecision",
          "when": "threavia.state == ready && threavia.hasProject"
        },
        {
          "command": "threavia.renameCore",
          "when": "threavia.state != unconfigured"
        },
        {
          "command": "threavia.removeCore",
          "when": "threavia.state != unconfigured"
        },
        {
          "command": "threavia.signOut",
          "when": "threavia.signedIn"
        }
      ],
      "view/title": [
        { "command": "threavia.refresh", "when": "view == threavia.backends", "group": "navigation@1" },
        {
          "command": "threavia.newSession",
          "when": "view == threavia.sidebar && threavia.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "threavia.refresh",
          "when": "view == threavia.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "threavia.signOut",
          "when": "view == threavia.sidebar && threavia.signedIn",
          "group": "settings"
        },
        {
          "command": "threavia.setCoreUrl",
          "when": "view == threavia.sidebar",
          "group": "settings"
        },
        {
          "command": "threavia.addCore",
          "when": "view == threavia.sidebar",
          "group": "settings"
        },
        {
          "command": "threavia.newTask",
          "when": "view == threavia.tasks && threavia.state == ready && threavia.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "threavia.switchProject",
          "when": "view == threavia.tasks && threavia.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "threavia.refresh",
          "when": "view == threavia.tasks",
          "group": "navigation@3"
        },
        {
          "command": "threavia.recordDecision",
          "when": "view == threavia.memory && threavia.state == ready && threavia.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "threavia.switchProject",
          "when": "view == threavia.memory && threavia.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "threavia.refresh",
          "when": "view == threavia.memory",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "threavia.newSession",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\.ready/",
          "group": "inline@1"
        },
        {
          "command": "threavia.refresh",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\./",
          "group": "inline@2"
        },
        {
          "command": "threavia.signIn",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\.(signedOut|unreachable)/",
          "group": "1_auth@1"
        },
        {
          "command": "threavia.signOut",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\..*\\.signedIn$/",
          "group": "1_auth@2"
        },
        {
          "command": "threavia.newSession",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\.ready/",
          "group": "2_session"
        },
        {
          "command": "threavia.renameCore",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\./",
          "group": "3_core@1"
        },
        {
          "command": "threavia.setCoreUrl",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\./",
          "group": "3_core@2"
        },
        {
          "command": "threavia.removeCore",
          "when": "view == threavia.sidebar && viewItem =~ /^core\\./",
          "group": "4_remove"
        },
        {
          "command": "threavia.approve",
          "when": "view == threavia.sidebar && viewItem == validation",
          "group": "inline@1"
        },
        {
          "command": "threavia.deny",
          "when": "view == threavia.sidebar && viewItem == validation",
          "group": "inline@2"
        },
        {
          "command": "threavia.approve",
          "when": "view == threavia.sidebar && viewItem == validation",
          "group": "1_answer@1"
        },
        {
          "command": "threavia.deny",
          "when": "view == threavia.sidebar && viewItem == validation",
          "group": "1_answer@2"
        },
        {
          "command": "threavia.answer",
          "when": "view == threavia.sidebar && viewItem == input",
          "group": "inline"
        },
        {
          "command": "threavia.answer",
          "when": "view == threavia.sidebar && viewItem == input",
          "group": "1_answer"
        },
        {
          "command": "threavia.unpinSession",
          "when": "view == threavia.sidebar && viewItem =~ /^session\\.pinned/",
          "group": "inline"
        },
        {
          "command": "threavia.pinSession",
          "when": "view == threavia.sidebar && viewItem == session",
          "group": "2_session@1"
        },
        {
          "command": "threavia.unpinSession",
          "when": "view == threavia.sidebar && viewItem =~ /^session\\.pinned/",
          "group": "2_session@1"
        },
        {
          "command": "threavia.renameSession",
          "when": "view == threavia.sidebar && viewItem =~ /^session/",
          "group": "2_session@2"
        },
        {
          "command": "threavia.archiveSession",
          "when": "view == threavia.sidebar && viewItem =~ /^session/",
          "group": "2_session@3"
        },
        {
          "command": "threavia.refreshRepository",
          "when": "view == threavia.sidebar && viewItem =~ /^session/",
          "group": "3_repository"
        },
        {
          "command": "threavia.openInBrowser",
          "when": "view == threavia.sidebar && viewItem =~ /^session/",
          "group": "4_browser"
        },
        {
          "command": "threavia.newSession",
          "when": "view == threavia.sidebar && viewItem == project",
          "group": "inline"
        },
        {
          "command": "threavia.newSession",
          "when": "view == threavia.sidebar && viewItem == project",
          "group": "1_project"
        },
        {
          "command": "threavia.startTask",
          "when": "view == threavia.tasks && viewItem == task.ready",
          "group": "inline"
        },
        {
          "command": "threavia.completeTask",
          "when": "view == threavia.tasks && viewItem == task.inProgress",
          "group": "inline"
        },
        {
          "command": "threavia.reopenTask",
          "when": "view == threavia.tasks && viewItem == task.done",
          "group": "inline"
        },
        {
          "submenu": "threavia.taskStatus",
          "when": "view == threavia.tasks && viewItem =~ /^task\\./",
          "group": "1_status"
        },
        {
          "command": "threavia.editTaskTitle",
          "when": "view == threavia.tasks && viewItem =~ /^task\\./",
          "group": "2_edit@1"
        },
        {
          "command": "threavia.editTaskDetails",
          "when": "view == threavia.tasks && viewItem =~ /^task\\./",
          "group": "2_edit@2"
        },
        {
          "command": "threavia.taskDependencies",
          "when": "view == threavia.tasks && viewItem =~ /^task\\./",
          "group": "2_edit@3"
        },
        {
          "command": "threavia.deleteTask",
          "when": "view == threavia.tasks && viewItem =~ /^task\\./",
          "group": "3_delete"
        },
        {
          "command": "threavia.pinDecision",
          "when": "view == threavia.memory && viewItem == decision.normal",
          "group": "inline"
        },
        {
          "command": "threavia.unpinDecision",
          "when": "view == threavia.memory && viewItem == decision.important",
          "group": "inline"
        },
        {
          "command": "threavia.pinDecision",
          "when": "view == threavia.memory && viewItem == decision.normal",
          "group": "1_pin"
        },
        {
          "command": "threavia.unpinDecision",
          "when": "view == threavia.memory && viewItem == decision.important",
          "group": "1_pin"
        },
        {
          "command": "threavia.supersedeDecision",
          "when": "view == threavia.memory && viewItem =~ /^decision\\.(important|normal)$/",
          "group": "2_change"
        },
        {
          "command": "threavia.deleteDecision",
          "when": "view == threavia.memory && viewItem =~ /^decision\\./",
          "group": "3_delete"
        }
      ],
      "editor/title": [
        {
          "command": "threavia.pinSession",
          "when": "activeWebviewPanelId == 'threavia.conversation' && !threavia.conversationPinned && !threavia.conversationDraft",
          "group": "navigation@1"
        },
        {
          "command": "threavia.unpinSession",
          "when": "activeWebviewPanelId == 'threavia.conversation' && threavia.conversationPinned && !threavia.conversationDraft",
          "group": "navigation@1"
        },
        {
          "command": "threavia.openInBrowser",
          "when": "activeWebviewPanelId == 'threavia.conversation' && !threavia.conversationDraft",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "threavia.ask",
          "when": "threavia.state == ready",
          "group": "threavia@1"
        }
      ],
      "explorer/context": [
        {
          "command": "threavia.ask",
          "when": "threavia.state == ready && !explorerResourceIsFolder",
          "group": "threavia@1"
        }
      ],
      "threavia.taskStatus": [
        {
          "command": "threavia.setTaskTodo",
          "when": "viewItem =~ /^task\\.(inProgress|done)$/",
          "group": "1_status@1"
        },
        {
          "command": "threavia.setTaskInProgress",
          "when": "viewItem =~ /^task\\.(ready|waiting|done)$/",
          "group": "1_status@2"
        },
        {
          "command": "threavia.setTaskDone",
          "when": "viewItem =~ /^task\\.(ready|waiting|inProgress)$/",
          "group": "1_status@3"
        }
      ]
    },
    "configuration": {
      "title": "Threavia",
      "properties": {
        "threavia.cores": {
          "type": "array",
          "default": [],
          "scope": "application",
          "markdownDescription": "The Threavia Cores this editor connects to, all at once. Add, rename and remove them with **Threavia: Add Core…**, **Rename Core…** and **Remove Core**; `id` is generated and keeps a Core the same Core when its name or address changes.",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Generated; leave it as it is."
              },
              "name": {
                "type": "string",
                "description": "What the sidebar and the notifications call this Core."
              },
              "url": {
                "type": "string",
                "markdownDescription": "Where it answers, such as `https://threavia.example.com`, or `http://localhost:8080` for a local Core."
              },
              "project": {
                "type": "string",
                "description": "The Project of this Core you work in, by name or id: listed first and expanded, and shown by Tasks and Memory until you turn to another."
              }
            }
          }
        },
        "threavia.coreUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDeprecationMessage": "Replaced by `#threavia.cores#`, where it moved on the first start of this version.",
          "description": "Where Threavia Core answered, before there could be several Cores."
        },
        "threavia.project": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDeprecationMessage": "Replaced by the `project` of each Core in `#threavia.cores#`, where it moved on the first start of this version.",
          "description": "The Project this workspace worked in, before there could be several Cores."
        },
        "threavia.clientName": {
          "type": "string",
          "default": "",
