# Local development environment for Threavia Core.
# Copy to .env and source it, or export the variables you need.
#
# Defaults match docker-compose.yml, so an unmodified `make dev-up && make
# run-core` works without any of these.

# --- Logging -----------------------------------------------------------------
THREAVIA_LOG_LEVEL=debug
THREAVIA_LOG_FORMAT=text

# --- Listeners ---------------------------------------------------------------
THREAVIA_HTTP_ADDR=:8080
THREAVIA_GRPC_ADDR=:9090

# --- PostgreSQL --------------------------------------------------------------
THREAVIA_POSTGRES_HOST=localhost
THREAVIA_POSTGRES_PORT=5432
THREAVIA_POSTGRES_USER=threavia
THREAVIA_POSTGRES_PASSWORD=threavia
THREAVIA_POSTGRES_DATABASE=threavia
THREAVIA_POSTGRES_SSLMODE=disable
THREAVIA_POSTGRES_AUTO_MIGRATE=true

# --- S3-compatible object storage --------------------------------------------
# Object storage is a V1 infrastructure requirement; the first vertical slice
# runs without it.
THREAVIA_S3_ENABLED=false
THREAVIA_S3_ENDPOINT=http://localhost:9000
THREAVIA_S3_BUCKET=threavia
THREAVIA_S3_ACCESS_KEY_ID=threavia
THREAVIA_S3_SECRET_ACCESS_KEY=threavia-dev-secret
THREAVIA_S3_FORCE_PATH_STYLE=true

# --- Authentication ----------------------------------------------------------
# none | basic | oidc
THREAVIA_AUTH_MODE=none
THREAVIA_AUTH_DEV_USER_ID=dev

# --- Backend control plane ---------------------------------------------------
# Development stop-gap until the registration and claim flows land: maps a
# static bearer token to a BackendInstance id. With no entry, every backend
# connection is rejected.
THREAVIA_BACKEND_DEV_TOKENS=dev-token=00000000-0000-0000-0000-000000000001

# --- Claude backend ----------------------------------------------------------
THREAVIA_BACKEND_CORE_ADDRESS=localhost:9090
THREAVIA_BACKEND_TOKEN=dev-token
THREAVIA_BACKEND_INSTANCE_NAME=laptop
# TLS is required for remote Core access; plaintext is for a local Core only.
THREAVIA_BACKEND_TLS_ENABLED=false
THREAVIA_BACKEND_CLAUDE_BINARY=claude
THREAVIA_BACKEND_DISCOVERY_ROOTS=
